# Sao chep file nay thanh .env va dien gia tri thuc te. KHONG commit file .env that.

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=quanlycuahang
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Chuoi bi mat ky JWT, toi thieu 256-bit (32 ky tu) cho thuat toan HS256
JWT_SECRET=change-me-to-a-long-random-secret-string

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker
