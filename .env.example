# Sao chep file nay thanh .env va dien gia tri thuc te. KHONG commit file .env that.

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=quanlycuahang
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Chuoi bi mat ky JWT, toi thieu 256-bit (32 ky tu) cho thuat toan HS256
JWT_SECRET=change-me-to-a-long-random-secret-string

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost

# --- Bao mat cookie refresh token ---
# true = kich ban VPS co HTTPS truoc container web (Nginx/Caddy + Let's Encrypt).
# false = kich ban LAN noi bo chi co HTTP (khong domain/TLS) — bat buoc phai tat, neu khong
# trinh duyet se tu choi luu cookie refresh token (RFC 6265 yeu cau HTTPS cho Secure cookie).
# Xem 2 kich ban trien khai: docs/phase1/component-deployment-diagram.md
AUTH_REFRESH_COOKIE_SECURE=true

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# --- Web (Nginx phuc vu SPA + proxy /api) ---
WEB_PORT=80

# --- Observability (tuy chon, chi can khi bat overlay docker-compose.observability.yml) ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Backup (tuy chon) - day ban sao luu ra NGOAI may chu qua rclone (can `rclone config` truoc).
# Rong = chi luu tai cho, xem scripts/backup.sh de biet phuong an thay the (rsync/scp thu cong).
RCLONE_REMOTE=

# --- AI Assistant (tuy chon - Prompt #11, tinh nang dot 1) ---
# Mat khau role Postgres chi-doc rieng cho AI (V30 tu tao role fruithouse_ai_readonly, chi SELECT
# tren 4 view whitelist, KHONG bao gio thay bang goc) - sinh ngau nhien, KHAC voi DB_PASSWORD.
AI_DB_READONLY_PASSWORD=change-me-ai-readonly
# Ten role chi-doc, thuong khong can doi trung voi ten role V30 da tao.
AI_DB_READONLY_USERNAME=fruithouse_ai_readonly
# Khoa goc AES-256 (32 byte, ma hoa base64) de ma hoa khoa API AI cua tung tenant luc luu settings -
# sinh bang: openssl rand -base64 32. Rong = tinh nang AI bi khoa hoan toan (AiKeyEncryptionService
# tu choi ma hoa/giai ma), khong anh huong phan con lai cua he thong.
AI_SETTINGS_ENCRYPTION_KEY=
# Model Claude mac dinh khi tenant chua tu chon - CAN kiem chung lai voi tai lieu Anthropic hien
# tai truoc khi trien khai that (xem Javadoc ClaudeAiProvider).
AI_DEFAULT_MODEL=claude-sonnet-5
